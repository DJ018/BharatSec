# Copy this file to .env and replace the placeholder values with your real keys.
# Gemini takes precedence when both keys are present.
BHARATSEC_SESSION_SECRET=
BHARATSEC_COOKIE_SECURE=
BHARATSEC_SESSION_DAYS=7
BHARATSEC_CORS_ORIGINS=
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = ignore the header).
BHARATSEC_TRUSTED_PROXY_HOPS=0
# Set to true only for a trusted shared workspace. Public binds default to false.
# BHARATSEC_ALLOW_REGISTRATION=true
BHARATSEC_BOOTSTRAP_USERNAME=
BHARATSEC_BOOTSTRAP_PASSWORD=
BHARATSEC_BOOTSTRAP_DISPLAY_NAME=BharatSec Administrator
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini
COPILOT_TIMEOUT=45
# Longest AI answer in tokens, and AI requests allowed per user per minute
AI_MAX_OUTPUT_TOKENS=2048
AI_RATE_LIMIT_PER_MINUTE=20
# Optional: Have I Been Pwned verified-domain breach checks
HIBP_API_KEY=
# Optional: VirusTotal reputation lookups during IOC enrichment
VIRUSTOTAL_API_KEY=
